generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  username             String        @unique
  password             String
  balance              Decimal       @default(0)
  sendtransactions     Transaction[] @relation("sendtransaction")
  receivedtransactions Transaction[] @relation("receivedtransaction")
}

model Transaction {
  id          String            @id @default(uuid())
  amount      Decimal
  description String
  senderid    String
  receiverid  String
  sender      User              @relation("sendtransaction", fields: [senderid], references: [id])
  receiver    User              @relation("receivedtransaction", fields: [receiverid], references: [id])
  createdAt   DateTime          @default(now())
  type        Category
  status      transactionStatus
  reason      String?
}

enum transactionStatus {
  fail
  success
}

enum Category {
  food
  bills
  personal
  misc
}
