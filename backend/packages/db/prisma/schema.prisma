generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  username             String        @unique
  password             String
  walletBalance        Decimal       @default(0)
  sendtransactions     Transaction[] @relation("sendtransaction")
  receivedtransactions Transaction[] @relation("receivedtransaction")
  bankDetails          BankDetails[]
  onrampTransactions   onrampTransactions[]
}

model Transaction {
  id          String    @id @default(uuid())
  amount      Decimal
  description String?
  sendername   String
  receivername  String
  createdAt   DateTime  @default(now())
  type        Category?
  status      String    @default("pending")
  reason      String?
  sender      User      @relation("sendtransaction", fields: [sendername], references: [username])
  receiver    User      @relation("receivedtransaction", fields: [receivername], references: [username])
}


model onrampTransactions{
  id    String  @id @default()
  provider String
  status String   @default("pending")
  type   onramptypes
  amount Decimal
  userID String 
  user User @relation(fields: [userID], references: [id])
  
}

model BankDetails {
  accountNumber Int    @id
  userID        String
  bankname      String
  balance       Int    @default(10000)

  user User @relation(fields: [userID], references: [id])
}

enum Category {
  food
  bills
  personal
  misc
}
enum onramptypes{
  add_money
  withdraw
}
